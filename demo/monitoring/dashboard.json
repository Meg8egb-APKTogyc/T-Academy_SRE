{
  "title": "Task Tracker — Deployment Strategies (Gateway API)",
  "uid": "task-tracker-deploy-strategies",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS по версиям",
      "description": "sum(rate(http_server_requests_seconds_count[2m])) by (version)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(http_server_requests_seconds_count{kubernetes_namespace=\"deploy-demo\"}[2m])) by (version)",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Доля v2 в трафике, %",
      "description": "Наглядно для canary: 10% -> 50% -> 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "100 * sum(rate(http_server_requests_seconds_count{kubernetes_namespace=\"deploy-demo\",version=\"1.2.0\"}[2m])) / sum(rate(http_server_requests_seconds_count{kubernetes_namespace=\"deploy-demo\"}[2m]))",
          "legendFormat": "v2 доля"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RPS по подам",
      "description": "Видно, как rolling update заменяет поды по одному.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(http_server_requests_seconds_count{kubernetes_namespace=\"deploy-demo\"}[2m])) by (kubernetes_pod_name, version)",
          "legendFormat": "{{kubernetes_pod_name}} ({{version}})"
        }
      ]
    }
  ]
}
