# Скопируйте в .env и при необходимости измените значения.
# docker compose автоматически подхватывает .env из корня проекта.

# --- Порты ---
SERVER_PORT=8080
FRONTEND_PORT=8080
BACKEND_PORT=8081
DB_HOST_PORT=5432

# --- Подключение к БД (backend и migrate) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=tasktracker
DB_USER=tasktracker
DB_PASSWORD=tasktracker
# Для локального запуска из IDE:
DB_URL=jdbc:postgresql://localhost:5432/tasktracker

INSTANCE_ID=local

# Накатывать демо-данные вместе со схемой (1 — да, 0/пусто — нет)
SEED_DEMO=1