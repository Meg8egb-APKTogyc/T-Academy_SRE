# Скопируйте в .env и при необходимости измените значения.
# docker compose автоматически подхватывает .env из корня проекта.

SERVER_PORT=8080
DB_NAME=tasktracker
DB_USER=tasktracker
DB_PASSWORD=tasktracker
# Для локального запуска вне Docker:
DB_URL=jdbc:postgresql://localhost:5432/tasktracker
INSTANCE_ID=local
