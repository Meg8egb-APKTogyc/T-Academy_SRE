        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
